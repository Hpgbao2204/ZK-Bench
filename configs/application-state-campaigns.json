{
  "schema_version": "1.0",
  "purpose": "E2/E3 matched-application campaign for the batched-state predicate",
  "defaults": {
    "schema_version": "1.0",
    "campaign_kind": "adapter-process",
    "evidence_class": "measured",
    "energy": {
      "provider": "unavailable",
      "unavailable_reason": "No documented hardware or OS energy counter is configured in WSL2"
    },
    "mode": "cold",
    "os_cache_primer_runs": 2,
    "repetitions": 10,
    "require_clean_git": true,
    "sampling_interval_ms": 5,
    "seed": 20260912,
    "threads": [16],
    "timeout_seconds": 14400
  },
  "adapters": {
    "groth16": {
      "adapter": "ark-groth16-0.6.0-bls12-381",
      "command": [".local/wsl-cargo-target/release/zkbench-ark-groth16-bls12-381"],
      "parallel_backend": "Arkworks Rayon global thread pool",
      "variant": "ark-groth16-0.6.0-bls12-381"
    },
    "plonk": {
      "adapter": "jellyfish-turboplonk-0.8.0-bls12-381-kzg",
      "command": [".local/wsl-cargo-target/release/zkbench-jellyfish-plonk"],
      "parallel_backend": "Jellyfish parallel feature with repository-local Rayon configuration",
      "variant": "jellyfish-turboplonk-0.8.0-bls12-381-kzg"
    },
    "stark": {
      "adapter": "winterfell-0.13.1-f128",
      "command": [".local/wsl-cargo-target/release/zkbench-winterfell-stark"],
      "parallel_backend": "Winterfell concurrent backend through repository-local Rayon pool",
      "variant": "winterfell-0.13.1-f128-state-air-v1"
    }
  },
  "workloads": {
    "state_application": {
      "claim_id": "PAPER-RQ2-STATE-APPLICATION-SCALING",
      "workload": "batched_state",
      "scales": [127, 255, 511, 1023, 2047, 4095, 8191],
      "smoke_scale": 127,
      "parameters": {
        "delta_schedule": "splitmix64-v1",
        "hash_rounds": 5,
        "scale_mode": "application_units",
        "stark_relation_mode": "application_predicate",
        "update_bits": 16
      },
      "relation": {
        "application_unit": "state update",
        "scale_interpretation": "input_scale is the number of real state updates; adding the initial row gives a power-of-two Winterfell trace",
        "private_inputs": ["one 16-bit bounded delta per update from the deterministic splitmix64-v1 fixture schedule"],
        "public_inputs": ["initial state", "final state", "aggregate H5 update digest"],
        "hash_primitive": "H5(x,y): s0=x+7y+11; sr=s(r-1)^5+(18+r), for r=1..5",
        "stark_air": "29 columns and 29 transition constraints of degree at most five"
      },
      "result_scope": "E2/E3 same-predicate state application-scaling campaign",
      "invalid_cases": [{
        "kind": "wrong_public_input",
        "repetitions": 3,
        "scales": [127],
        "threads": [16]
      }]
    }
  }
}
